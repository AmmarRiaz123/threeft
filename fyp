        "dataset_base_path = '/content/EuroSAT/eurosat'\n",
        "train_dir = os.path.join(dataset_base_path, 'train')\n",
        "val_dir = os.path.join(dataset_base_path, 'val')\n",
        "\n",
        "# Create train and validation directories\n",
        "os.makedirs(train_dir, exist_ok=True)\n",
        "os.makedirs(val_dir, exist_ok=True)\n",
        "\n",
        "# Define the split ratio\n",
        "train_split_ratio = 0.8\n",
        "\n",
        "# Iterate through each class directory\n",
        "for class_name in os.listdir(dataset_base_path):\n",
        "    class_path = os.path.join(dataset_base_path, class_name)\n",
        "    if os.path.isdir(class_path) and class_name not in ['train', 'val']:\n",
        "        # Create class directories in train and val\n",
        "        os.makedirs(os.path.join(train_dir, class_name), exist_ok=True)\n",
        "        os.makedirs(os.path.join(val_dir, class_name), exist_ok=True)\n",
        "\n",
        "        # List and shuffle image files\n",
        "        images = [f for f in os.listdir(class_path) if f.endswith('.jpg')] # Assuming images are jpg\n",
        "        random.shuffle(images)\n",
        "\n",
        "        # Calculate split point\n",
        "        split_point = int(len(images) * train_split_ratio)\n",
        "\n",
        "        # Copy images to train and val directories\n",
        "        train_images = images[:split_point]\n",
        "        val_images = images[split_point:]\n",
        "\n",
        "        for img_name in train_images:\n",
        "            src_path = os.path.join(class_path, img_name)\n",
        "            dest_path = os.path.join(train_dir, class_name, img_name)\n",
        "            shutil.copy(src_path, dest_path)\n",
        "\n",
